{
  "name": "mahaam",
  "version": "1.0.0",
  "description": "مهام — A calm, editorial task manager with Eisenhower Matrix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dmg",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --mac --dir"
  },
  "author": "Mahaam",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.mahaam.productivity",
    "productName": "Mahaam",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Mahaam",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.png"
    ]
  }
}
